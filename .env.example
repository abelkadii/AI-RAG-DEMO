# OpenAI-compatible chat API (omit the key to use the local deterministic fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_JSON_MAX_TOKENS=500
OPENAI_ANSWER_MAX_TOKENS=900

# Developer-only bounded smoke mode (for example: executive-summary)
SMOKE_TEST_SECTIONS=

# Optional OpenAI-compatible embeddings. If unset, local hashed embeddings are used.
OPENAI_EMBEDDING_MODEL=

PDF_URL=https://docs.aws.amazon.com/pdfs/wellarchitected/2024-06-27/framework/wellarchitected-framework-2024-06-27.pdf
PDF_PATH=data/aws-well-architected-framework.pdf
INDEX_DIR=data/index
LLM_MODE=auto
DEMO_ACCESS_CODE=
